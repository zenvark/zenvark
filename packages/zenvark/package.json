{
  "name": "zenvark",
  "version": "2.0.0",
  "description": "Distributed resilience primitives coordinated via Redis: a circuit breaker and an adaptive semaphore for high-availability applications",
  "keywords": [
    "zenvark",
    "circuit",
    "breaker",
    "circuit-breaker",
    "semaphore",
    "concurrency",
    "aimd",
    "redis",
    "distributed"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenvark/zenvark.git",
    "directory": "packages/zenvark"
  },
  "homepage": "https://zenvark.github.io/zenvark",
  "bugs": {
    "url": "https://github.com/zenvark/zenvark/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "docker:start": "docker compose up -d",
    "docker:stop": "docker compose down",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "pnpm run docker:start && pnpm run test:coverage && pnpm run docker:stop"
  },
  "devDependencies": {
    "@lokalise/tsconfig": "^5.0.0",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.0",
    "ioredis": "^6.0.0",
    "rimraf": "^6.0.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "redis-semaphore": "^5.7.0"
  },
  "peerDependencies": {
    "ioredis": "^5.0.0 || ^6.0.0"
  }
}
