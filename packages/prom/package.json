{
  "name": "@zenvark/prom",
  "version": "2.0.0",
  "description": "Prometheus metrics for Zenvark Circuit Breaker",
  "keywords": [
    "zenvark",
    "circuit",
    "breaker",
    "circuit-breaker",
    "prometheus",
    "metrics",
    "monitoring",
    "observability"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zenvark/zenvark.git",
    "directory": "packages/prom"
  },
  "homepage": "https://zenvark.github.io/zenvark",
  "bugs": {
    "url": "https://github.com/zenvark/zenvark/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "typecheck": "tsc",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ci": "pnpm run test:coverage"
  },
  "devDependencies": {
    "@lokalise/tsconfig": "^5.0.0",
    "@prometheus-io/client": "^0.16.1",
    "@types/node": "^24.10.1",
    "@vitest/coverage-v8": "^5.0.0",
    "rimraf": "^6.0.1",
    "typescript": "7.0.2",
    "vitest": "^5.0.0",
    "zenvark": "workspace:^"
  },
  "peerDependencies": {
    "@prometheus-io/client": "^0.16.0",
    "zenvark": "^2.0.0"
  }
}
