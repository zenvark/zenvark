{
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.3.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "check": "oxfmt --check . '!packages/**' '!apps/**' && oxlint --ignore-pattern 'packages/**' --ignore-pattern 'apps/**' && turbo run check",
    "check:fix": "turbo run check:fix && oxlint --fix --ignore-pattern 'packages/**' --ignore-pattern 'apps/**' && oxfmt . '!packages/**' '!apps/**'",
    "test:ci": "turbo run test:ci --concurrency=1",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@lokalise/tsconfig": "^5.0.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "turbo": "^2.10.12",
    "typescript": "^7.0.2"
  }
}
